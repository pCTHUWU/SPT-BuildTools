        <Reference Include="System.Core" />
    </ItemGroup>

    <!-- Deploys straight into the live SPT install. This mod is self-contained: no server half,
         no companion build to disable, so a plain copy is the whole install step. -->
    <Target Name="CopyToPlugins" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <OutputDll Include="$(ProjectDir)$(OutDir)$(TargetName).dll" />
        </ItemGroup>
        <MakeDir Directories="C:\SPT\BepInEx\plugins\BuildScreenFilter" />
        <Copy SourceFiles="@(OutputDll)" DestinationFolder="C:\SPT\BepInEx\plugins\BuildScreenFilter" />
    </Target>

    <!-- Records the commit this DLL came from, so the startup banner can name it. A deployed
       build is otherwise identifiable only by its file date, which is no help when something
       goes wrong and the question is which build was actually running. "-dirty" marks a build
       made from uncommitted tracked changes - the case that most needs saying out loud, since
       that DLL corresponds to no commit at all.

       Two plain git calls rather than one `git describe`, whose dirty flag needs a tag-exclude
       glob to stop tags winning, and that glob would be at the mercy of how MSBuild's cmd.exe
       and git's MSYS layer each handle quoting. Neither call can fail the build: no git, or a
       fresh clone with no commits, just yields "unknown". -->
    <Target Name="StampBuild" BeforeTargets="CoreCompile">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitSha" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
    </Exec>
    <PropertyGroup>
      <GitSha Condition="'$(GitSha)' == ''">unknown</GitSha>
      <BuildStampValue>$(GitSha)</BuildStampValue>
      <BuildStampValue Condition="'$(GitDirty)' != ''">$(GitSha)-dirty</BuildStampValue>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildStamp.g.cs"
                      Lines="// Generated by the StampBuild target. Not source - do not edit or commit.;namespace $(RootNamespace) { internal static class BuildStamp { public const string Value = &quot;$(BuildStampValue)&quot;%3B } }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildStamp.g.cs" />
    </ItemGroup>
    </Target>

</Project>
